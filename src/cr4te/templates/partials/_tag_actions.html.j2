{% import "partials/_icons.html.j2" as icons %}

{% macro render_tag_action_menu(tag, category, site_labels, menu_id, path_to_root="", creator_name="", include_creator_projects=false) %}
{% set tag_query = category ~ ':' ~ tag %}
{% set creators_label = site_labels.entity.creators | lower %}
{% set projects_label = site_labels.entity.projects | lower %}
<span class="tag-menu" data-menu>
  <button type="button"
          class="tag-action-toggle"
          aria-label="{{ site_labels.controls.tag_actions_label_format | format_phrase(tag=tag) }}"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="{{ menu_id }}"
          data-menu-toggle>
    <span class="tag">{{ tag }}</span>
    <span class="tag-action-icon" aria-hidden="true">{{ icons.chevron_down_icon() }}</span>
  </button>
  <span class="tag-action-panel menu-panel" id="{{ menu_id }}" role="menu" data-menu-panel>
    <a class="tag-action-option menu-option" role="menuitem" tabindex="-1" href="{{ path_to_root }}index.html?tag={{ tag_query | urlencode }}">{{ site_labels.controls.find_in_creators_format | format_phrase(creators=creators_label) }}</a>
    <a class="tag-action-option menu-option" role="menuitem" tabindex="-1" href="{{ path_to_root }}projects.html?tag={{ tag_query | urlencode }}">{{ site_labels.controls.find_in_projects_format | format_phrase(projects=projects_label) }}</a>
    {% if include_creator_projects %}
    <a class="tag-action-option menu-option" role="menuitem" tabindex="-1" href="{{ path_to_root }}projects.html?tag={{ ('\"' ~ creator_name ~ '\" ' ~ tag_query) | urlencode }}">{{ site_labels.controls.find_in_creator_projects_format | format_phrase(projects=projects_label, creator=creator_name) }}</a>
    {% endif %}
  </span>
</span>
{% endmacro %}
